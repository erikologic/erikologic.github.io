---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<h1>Hi! 👋</h1>
			<p>I'm Enrico.</p>
			<p>
				I'm setting up this site as a home for my writing, ideas, and public learning record.
				Have a look around, read the <a href="/blog">blog</a>, or learn more in <a href="/whoami">Whoami</a>.
			</p>
		</main>
		<Footer />
	</body>
</html>
